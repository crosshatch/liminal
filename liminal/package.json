{
  "name": "liminal",
  "version": "0.17.22",
  "description": "Effect x Actors",
  "bugs": {
    "url": "https://github.com/crosshatch/liminal/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/crosshatch/liminal.git",
    "directory": "liminal"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.ts",
    "./*": "./*.ts",
    "./alchemy": "./alchemy/index.ts",
    "./experimental": "./experimental/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./alchemy": "./alchemy/index.js",
      "./experimental": "./experimental/index.js",
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@crosshatch/util": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "alchemy": {
      "optional": true
    }
  }
}
