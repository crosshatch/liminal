{
  "name": "liminal-root",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "node ./konfik/main.ts clean --ignore '**/repos'",
    "dev": "pnpm i && PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false turbo run dev //#watch //#aliases",
    "aliases": "caddy run --config ./Caddyfile",
    "format": "oxfmt --config ./.oxfmtrc.jsonc",
    "sync-repos": "node ./konfik/main.ts sync-repos",
    "destroy": "alchemy destroy",
    "plan": "alchemy plan",
    "prepare": "effect-tsgo patch --oxlint",
    "test": "vitest run",
    "watch": "tsc -b -w",
    "lint": "oxlint --disable-nested-config --type-aware"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@crosshatch/alchemy": "workspace:*",
    "@crosshatch/util": "workspace:*",
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/expect": "catalog:",
    "@vitest/web-worker": "catalog:",
    "alchemy": "catalog:",
    "crosshatch": "workspace:*",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pkg-pr-new": "catalog:",
    "playwright": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
