{
  "name": "liminal-root",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "clean": "node ./konfik/main.ts clean --ignore '**/repos'",
    "dev": "pnpm i && PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false turbo run dev //#watch //#aliases",
    "aliases": "caddy run --config ./Caddyfile",
    "format": "oxfmt --config ./.oxfmtrc.jsonc",
    "sync-repos": "node ./konfik/main.ts sync-repos",
    "destroy": "alchemy destroy",
    "plan": "alchemy plan",
    "prepare": "effect-tsgo patch --oxlint",
    "test": "vitest run",
    "watch": "tsc -b -w",
    "lint": "oxlint --disable-nested-config --type-aware"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@crosshatch/alchemy": "workspace:*",
    "@crosshatch/util": "workspace:*",
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/expect": "catalog:",
    "@vitest/web-worker": "catalog:",
    "alchemy": "catalog:",
    "crosshatch": "workspace:*",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pkg-pr-new": "catalog:",
    "playwright": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
